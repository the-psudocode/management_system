PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration (Requirement: Environment-based DATABASE_URL)
DATABASE_URL=postgresql://username:password@localhost:5432/brightloop_billing

# PostgreSQL Connection Pool Parameters
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
DB_SSL=false

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Firebase Authentication Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended for local dev / staging)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 2: Environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to true for offline mock auth mode (e.g. running tests without Firebase credentials)
MOCK_AUTH=false
